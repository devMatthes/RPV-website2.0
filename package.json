{
  "name": "rpv-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "api:dev": "node --env-file-if-exists=.env.backend --experimental-strip-types server/index.ts",
    "api:password": "node --experimental-strip-types server/hash-password.ts",
    "api:check": "tsc -p server/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc --local",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc --include-runtime false",
    "cf:check": "tsc -p cloudflare/tsconfig.json --noEmit",
    "cf:smoke": "node --experimental-strip-types scripts/cloudflare-smoke.mjs",
    "cf:dry-run:staging": "wrangler deploy --config cloudflare/wrangler.jsonc --env staging --dry-run",
    "cf:dry-run:production": "wrangler deploy --config cloudflare/wrangler.jsonc --env production --dry-run",
    "cf:deploy:staging": "wrangler deploy --config cloudflare/wrangler.jsonc --env staging",
    "cf:deploy:production": "wrangler deploy --config cloudflare/wrangler.jsonc --env production",
    "cf:db:test": "node scripts/cloudflare-db-test.mjs",
    "cf:db:migrate:local": "wrangler d1 migrations apply DB --config cloudflare/wrangler.jsonc --local",
    "cf:db:migrate:staging": "wrangler d1 migrations apply DB --config cloudflare/wrangler.jsonc --env staging --remote",
    "cf:db:migrate:production": "wrangler d1 migrations apply DB --config cloudflare/wrangler.jsonc --env production --remote",
    "cf:api:test": "node --experimental-strip-types scripts/cloudflare-api-test.mjs",
    "cf:files:test": "node --experimental-strip-types scripts/cloudflare-files-test.mjs",
    "cf:panel:build": "node scripts/cloudflare-panel-build.mjs",
    "cf:admin:test": "node --experimental-strip-types scripts/cloudflare-admin-test.mjs",
    "precf:dev": "npm run cf:panel:build",
    "precf:deploy:staging": "npm run cf:panel:build",
    "precf:deploy:production": "npm run cf:panel:build",
    "cf:access:test": "node --experimental-strip-types scripts/cloudflare-access-test.mjs",
    "cf:contact:test": "node --experimental-strip-types scripts/cloudflare-contact-test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@mjackson/multipart-parser": "0.10.1",
    "astro": "^7.3.8",
    "browser-image-compression": "^2.0.2",
    "fastify": "^5.12.5",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "lighthouse": "^13.5.0",
    "miniflare": "5.20261006.1-alpha",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
