---
import ContentLayout from '../layouts/ContentLayout.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import ContentCta from '../components/content/ContentCta.astro';
import Faq from '../components/offer/Faq.astro';
import {faqGroups} from '../data/content';
const home=import.meta.env.BASE_URL;
---
<ContentLayout title="FAQ" description="Najczęstsze pytania o planowanie instalacji, wycenę, realizację i kontakt z RPV.">
<section class="content-section container"><Breadcrumbs label="FAQ" /><h1>Dobre pytania.<br />Jasne odpowiedzi.</h1><p class="content-description">Zebraliśmy najważniejsze informacje o planowaniu instalacji i kontakcie z RPV. Szczegółowe pytania znajdziesz także na podstronach usług.</p></section>
{faqGroups.map((group,i)=><section class="content-section container" aria-labelledby={`faq-group-${i}`}><h2 class="content-heading" id={`faq-group-${i}`}>{group.title}</h2><Faq items={group.items} />{i===2&&<><a class="text-link" href={`${home}uslugi/dofinansowania-oze/`}>Dofinansowania OZE →</a><a class="text-link" href="#kontakt">Zgłoś serwis →</a></>}</section>)}
<ContentCta />
</ContentLayout>
