---
import ContentLayout from '../layouts/ContentLayout.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import TextBlock from '../components/offer/TextBlock.astro';
import {notFoundServices} from '../data/form-states';
const home=import.meta.env.BASE_URL;
---
<ContentLayout title="Nie znaleziono strony" description="Adres mógł się zmienić albo zawierać literówkę. Wróć na stronę główną lub wybierz usługę RPV.">
<section class="content-section container"><Breadcrumbs label="404" /><p class="status-code">404</p><h1>Tej strony<br /> nie znaleźliśmy.</h1><p class="content-description">Adres mógł się zmienić albo zawierać literówkę. Wróć na stronę główną lub wybierz usługę.</p><div class="actions"><Button href={home}>Strona główna</Button><a class="text-link" href={`${home}kontakt/`}>Kontakt →</a></div></section>
<section class="content-section container"><h2 class="content-heading">Szukasz rozwiązania?</h2><div class="cards">{notFoundServices.map(block=><article><TextBlock block={block} /><a class="text-link" href={`${home}uslugi/${block.slug}/`}>Zobacz usługę →</a></article>)}</div></section>
</ContentLayout>
<style>.status-code{font:700 96px/110px var(--font-body);letter-spacing:-.7px;color:var(--color-accent)}.actions{display:flex;flex-direction:column;align-items:start;gap:16px}.actions :global(.button){width:190px;min-height:48px;padding-block:12px}.cards{width:100%;display:grid;grid-template-columns:minmax(0,1fr);gap:24px}.cards article{display:flex;flex-direction:column;align-items:start;gap:24px;padding:24px;border:1px solid var(--color-border);border-radius:16px}@media(min-width:700px){.actions{flex-direction:row;align-items:center}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:1100px){.cards{grid-template-columns:repeat(3,minmax(0,1fr))}}</style>
