---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
---
<BaseLayout>
  <div class="page"><Header /><main id="main"><Hero /></main></div>
</BaseLayout>
<style>
  .page { max-width: 1920px; margin-inline: auto; position: relative; isolation: isolate; }
  .page::before { content: ''; position: absolute; inset: 0 0 auto; height: 581px; background: linear-gradient(#1b85e81a, transparent); pointer-events: none; z-index: -1; }
</style>
