---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import Audiences from '../components/home/Audiences.astro';
import PhotoBanner from '../components/home/PhotoBanner.astro';
import Services from '../components/home/Services.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Experience from '../components/home/Experience.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <div class="page"><Header /><main id="main"><Hero /><Audiences /><PhotoBanner /><Services /><Testimonials /><Experience /><PhotoBanner variant="technician" /></main><Footer /></div>
</BaseLayout>
<style>
  .page { max-width: 1920px; margin-inline: auto; position: relative; isolation: isolate; }
  .page::before { content: ''; position: absolute; inset: 0 0 auto; height: 581px; background: linear-gradient(#1b85e81a, transparent); pointer-events: none; z-index: -1; }
</style>
