---
import ContentLayout from '../layouts/ContentLayout.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import ContentCta from '../components/content/ContentCta.astro';
import OfferImage from '../components/offer/OfferImage.astro';
import TextBlock from '../components/offer/TextBlock.astro';
import Button from '../components/Button.astro';
import {principles,aboutAudiences} from '../data/content';
const home=import.meta.env.BASE_URL;
---
<ContentLayout title="O nas" description="Poznaj RPV. Projektowanie, montaż i uruchomienie instalacji dla domów, firm i inwestycji." about>
<section class="content-section container"><Breadcrumbs label="O nas" /><div class="about-hero"><div class="hero-copy"><p class="eyebrow">O NAS</p><h1>Poznaj RPV.<br />Od projektu<br />do uruchomienia.</h1><p class="content-description">Projektujemy i montujemy instalacje dla domów, firm i inwestycji. Łączymy dobór urządzeń, montaż i uruchomienie w jeden spójny proces.</p><Button href={`${home}realizacje/`}>Zobacz realizacje</Button></div><figure><OfferImage image="technician" alt="Technik przy instalacji paneli fotowoltaicznych" priority class="about-photo" /><figcaption class="content-note">Zdjęcie poglądowe z materiałów RPV.</figcaption></figure></div></section>
<section class="content-section container"><h2 class="content-heading">Najpierw potrzeby.<br />Potem rozwiązanie.</h2><p class="content-description">Patrzymy na cały system, nie tylko na pojedyncze urządzenie.</p><div class="content-columns">{principles.map(block=><TextBlock block={block} />)}</div></section>
<section class="content-section container"><h2 class="content-heading">Dom. Firma. Inwestycja.</h2><p class="content-description">Różna skala. Ten sam punkt wyjścia — Twoje potrzeby.</p><div class="content-columns">{aboutAudiences.map(block=><div class="audience"><TextBlock block={block} /><a class="text-link" href={`${home}${block.slug}/`}>Poznaj ofertę →</a></div>)}</div></section>
<section class="content-section container"><h2 class="content-heading">Sprawdź to w realizacjach.</h2><p class="content-description">W szczegółach projektów znajdziesz zakres prac i parametry instalacji. To miejsce na konkretne przykłady naszej pracy.</p><a class="text-link" href={`${home}realizacje/`}>Zobacz realizacje →</a><div class="divider"></div><h2 class="content-heading">Masz już instalację?</h2><p class="content-description">Zgłoś potrzebę serwisu. Opis problemu, zdjęcia i oznaczenia urządzeń pomogą nam zrozumieć sytuację.</p><a class="text-link" href="#kontakt">Przejdź do serwisu →</a></section>
<ContentCta />
</ContentLayout>
<style>.about-hero{display:grid;gap:48px;width:100%}.hero-copy{display:flex;flex-direction:column;align-items:start;gap:24px;min-width:0}figure{display:flex;flex-direction:column;gap:12px;min-width:0}figure :global(.about-photo){height:300px}.hero-copy :global(.button){width:200px;min-height:48px;padding-block:12px}.audience{display:flex;flex-direction:column;justify-content:space-between;gap:16px}@media(min-width:700px){figure :global(.about-photo){height:460px}}@media(min-width:1100px){.about-hero{grid-template-columns:repeat(2,minmax(0,600px))}.audience{min-height:197px}}</style>
