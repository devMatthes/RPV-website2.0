---
import LiveAdminLayout from '../../../layouts/LiveAdminLayout.astro';
---
<LiveAdminLayout>
  <section class="live-login" data-login-view>
    <p class="admin-eyebrow">RPV · Panel wewnętrzny</p><h1 class="admin-title">Zaloguj się</h1><p class="admin-subtitle">Dostęp do zgłoszeń mają upoważnione osoby.</p>
    <form data-login-form hidden={import.meta.env.PANEL_BUILD==='true'}><label>Login<input name="username" autocomplete="username" required maxlength="100" /></label><label>Hasło<input name="password" type="password" autocomplete="current-password" required maxlength="200" /></label><button class="admin-primary" type="submit">Zaloguj się</button></form>
  </section>
  <p data-admin-feedback class="live-feedback" role="status" aria-live="polite" tabindex="-1" hidden></p>
  <section data-list-view hidden>
    <div class="live-heading"><div><p class="admin-eyebrow">Obsługa klienta</p><h1 class="admin-title" data-list-title>Zgłoszenia serwisowe</h1><p class="admin-subtitle">Zgłoszenia zapisane przez formularz na stronie.</p></div><button class="admin-control" data-refresh>Odśwież</button></div>
    <div class="live-filters"><label>Szukaj<input data-search type="search" placeholder="Numer, klient, adres, instalacja" /></label><label>Status<select data-status-filter><option value="">Wszystkie</option><option value="new">Nowe</option><option value="active">W trakcie</option><option value="waiting">Oczekujące</option><option value="closed">Zamknięte</option></select></label><label>Instalacja<select data-installation-filter><option value="">Wszystkie</option><option>Fotowoltaika</option><option>Magazyn energii</option><option>Pompa ciepła</option><option>Klimatyzacja</option><option>Instalacja elektryczna</option><option>Inna instalacja</option></select></label></div>
    <p data-list-summary class="admin-caption" role="status"></p><div class="live-cases" data-live-cases></div>
    <div class="live-pagination"><button class="admin-control" data-previous>Poprzednia</button><span data-pagination></span><button class="admin-control" data-next>Następna</button></div>
  </section>
  <section data-detail-view hidden>
    <button class="admin-control" data-back>← Lista zgłoszeń</button>
    <div class="live-heading"><div><p class="admin-eyebrow" data-reference></p><h1 class="admin-title" data-client></h1><p class="admin-subtitle" data-submitted></p></div></div>
    <div class="live-detail-grid"><div class="live-detail-content">
      <section class="live-card"><h2>Dane kontaktowe</h2><div data-client-contact></div></section>
      <section class="live-card" data-service-only><h2>Adres instalacji</h2><dl data-address></dl></section>
      <section class="live-card" data-service-only><h2>Instalacja</h2><dl data-installation></dl></section>
      <section class="live-card" data-contact-only hidden><h2>Temat wiadomości</h2><p data-topic></p></section>
      <section class="live-card"><h2 data-message-title>Opis problemu</h2><p class="live-message" data-message></p></section>
      <section class="live-card" data-service-only><h2>Załączniki</h2><div class="live-files" data-attachments></div></section>
      <section class="live-card"><h2>Historia i notatki</h2><ol class="live-history" data-history></ol></section>
    </div><aside class="live-card live-manage"><h2 data-manage-title>Zarządzanie zgłoszeniem</h2><form data-manage-form><label>Status<select name="status"><option value="new">Nowe</option><option value="active">W trakcie</option><option value="waiting">Oczekujące</option><option value="closed">Zamknięte</option></select></label><label>Opiekun<select name="owner"><option value="">Nieprzypisane</option></select></label><label>Notatka wewnętrzna<textarea name="note" maxlength="2000" placeholder="Notatka dla osoby obsługującej zgłoszenie"></textarea></label><button type="submit" class="admin-primary">Zapisz zmiany</button></form></aside></div>
  </section>
</LiveAdminLayout>
<style>
.live-login{max-width:480px;margin:48px auto}.live-login form,.live-manage form{display:flex;flex-direction:column;gap:20px;margin-top:24px}label{display:flex;flex-direction:column;gap:8px;font:500 14px/21px var(--font-ui)}input,select,textarea{width:100%;min-width:0;border:1px solid var(--color-border);border-radius:8px;padding:12px;background:#0d0d0d;color:#fff;font:400 14px/22px var(--font-ui);min-height:48px;color-scheme:dark}textarea{min-height:130px;resize:vertical}.live-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;margin:24px 0}.live-filters.is-contact{grid-template-columns:2fr 1fr}.live-filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px;margin:24px 0}.live-feedback{border:1px solid var(--color-border);padding:16px;border-radius:8px;margin-bottom:24px;overflow-wrap:anywhere}.live-cases{display:grid;gap:12px}.live-cases :global(a){display:grid;grid-template-columns:140px minmax(0,1fr) 120px;gap:16px;padding:20px;border:1px solid var(--color-border);border-radius:12px;min-width:0}.live-cases :global(a:hover){border-color:#666}.live-cases :global(strong){font:600 16px/24px var(--font-ui);overflow-wrap:anywhere}.live-cases :global(p){color:var(--color-muted);font:400 13px/20px var(--font-ui);overflow-wrap:anywhere}.live-pagination{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:24px}.live-detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:24px}.live-detail-content{display:flex;flex-direction:column;gap:20px;min-width:0}.live-card{padding:24px;border:1px solid var(--color-border);border-radius:12px;background:var(--color-card);min-width:0}.live-card h2{font:600 18px/26px var(--font-ui);margin-bottom:16px}.live-card :global(a){display:block;overflow-wrap:anywhere;padding-block:6px;color:#fff}.live-card :global(dl){display:grid;grid-template-columns:minmax(100px,.6fr) minmax(0,1fr);gap:12px;font:400 14px/21px var(--font-ui)}.live-card :global(dt){color:var(--color-muted)}.live-card :global(dd){margin:0;overflow-wrap:anywhere}.live-manage{align-self:start}.live-message{white-space:pre-wrap;overflow-wrap:anywhere;font:400 14px/22px var(--font-ui)}.live-files{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}.live-files :global(img){width:100%;height:140px;object-fit:contain;border-radius:8px;background:#080808}.live-files :global(p){font:400 13px/20px var(--font-ui);overflow-wrap:anywhere}.live-files :global(button){min-height:44px;border:1px solid var(--color-border);border-radius:8px;background:none;color:#fff;padding:10px}.live-history{padding-left:20px;display:flex;flex-direction:column;gap:16px}.live-history :global(li){white-space:pre-wrap;overflow-wrap:anywhere;font:400 14px/22px var(--font-ui)}[hidden]{display:none!important}@media(max-width:1099px){.live-detail-grid{grid-template-columns:minmax(0,1fr)}.live-filters,.live-filters.is-contact{grid-template-columns:minmax(0,1fr)}.live-cases :global(a){grid-template-columns:minmax(0,1fr)}.live-heading{align-items:start}.live-heading .admin-control{flex-shrink:0}.live-login{margin:24px 0}}
</style>
