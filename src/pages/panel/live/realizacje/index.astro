---
import LiveAdminLayout from '../../../../layouts/LiveAdminLayout.astro';
import {cmsCategories} from '../../../../lib/cms-project';
const fields=[['title','Tytuł *',120],['slug','Adres realizacji *',100],['location','Lokalizacja (miejscowość)',160],['power','Moc / pojemność',100],['building','Typ budynku',120],['date','Data realizacji',10]] as const;
const texts=[['description','Krótki opis',400],['introduction','Wprowadzenie',2000],['assumptions','Założenia projektu',3000],['scope','Zakres prac',3000],['result','Rezultaty — wyłącznie potwierdzone dane',3000],['specification','Specyfikacja — jeden parametr w wierszu',3000]] as const;
---
<LiveAdminLayout cms>
 <section class="cms" data-cms-view hidden>
  <div class="cms-heading"><div><p class="admin-eyebrow">Treści strony</p><h1 class="admin-title">Realizacje</h1><p class="admin-subtitle">Przygotuj wpis i zatwierdź wersję do publikacji.</p></div><button data-cms-new class="admin-primary">Dodaj realizację</button></div>
  <p class="cms-note">Zapis szkicu i zatwierdzenie nie zmieniają jeszcze publicznej strony. Publikacja zostanie uruchomiona w kolejnym etapie.</p>
  <section data-cms-list><label>Szukaj realizacji<input data-cms-search type="search" placeholder="Tytuł lub adres" maxlength="120" /></label><div data-cms-entries class="cms-list"></div><div class="cms-actions"><button data-cms-prev class="admin-control">Poprzednia</button><span data-cms-pagination></span><button data-cms-next class="admin-control">Następna</button></div></section>
  <form data-cms-editor hidden>
   <div class="cms-actions"><button type="button" data-cms-back class="admin-control">← Lista realizacji</button><span data-cms-revision></span></div>
   <div class="cms-fields">{fields.map(([name,label,max])=><label>{label}<input name={name} required={name==='title'||name==='slug'} maxlength={max} type={name==='date'?'date':'text'} /></label>)}<label>Kategoria<select name="category">{cmsCategories.map(category=><option value={category}>{({'fotowoltaika':'Fotowoltaika','magazyny-energii':'Magazyny energii','pompy-ciepla':'Pompy ciepła','instalacje':'Instalacje'})[category]}</option>)}</select></label></div>
   {texts.map(([name,label,max])=><label>{label}<textarea name={name} maxlength={max}></textarea></label>)}
   <label class="cms-checkbox"><input name="archived" type="checkbox" />Archiwalna — przygotuj wycofanie ze strony</label>
   <section><h2 class="cms-section-title">Zdjęcia i okładka</h2><p class="cms-note">Pierwsze zdjęcie będzie okładką. Maksymalnie 12 zdjęć, oryginał do 20 MB, po przygotowaniu do 5 MB każde. JPG, PNG, WebP lub HEIC/HEIF. Dodaj opis każdego zdjęcia.</p><label>Dodaj zdjęcie<input data-cms-upload type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif" /></label><div data-cms-images class="cms-images"></div></section>
   <div class="cms-actions"><button type="submit" class="admin-primary">Zapisz szkic</button><button type="button" data-cms-approve class="admin-control">Zatwierdź zapisaną wersję</button><button type="button" data-cms-preview class="admin-control">Podgląd treści</button></div>
  </form>
  <section data-cms-preview-view class="cms-preview" hidden><h2 data-preview-title></h2><p data-preview-description></p><div data-preview-body></div></section>
 </section>
 <p data-cms-feedback class="cms-feedback" role="status" aria-live="polite" tabindex="-1">Wczytujemy panel…</p>
 <a data-cms-login class="admin-primary" href="" hidden>Zaloguj się ponownie</a>
 <script>import '../../../../scripts/admin-projects';</script>
</LiveAdminLayout>
<style is:global>
.cms{max-width:1100px}.cms-heading,.cms-actions{display:flex;gap:16px;align-items:center;justify-content:space-between;margin:24px 0;flex-wrap:wrap}.cms-heading .admin-primary{flex-shrink:0}.cms-note,.cms-feedback{font:400 14px/22px var(--font-ui);color:var(--color-muted);margin:16px 0;overflow-wrap:anywhere}.cms-feedback{padding:16px;border:1px solid var(--color-border);border-radius:8px}.cms label{display:flex;flex-direction:column;gap:8px;font:500 14px/22px var(--font-ui);margin:16px 0}.cms input,.cms select,.cms textarea{width:100%;min-width:0;border:1px solid var(--color-border);border-radius:8px;padding:12px;background:#101010;color:#fff;min-height:48px;font:400 14px/22px var(--font-ui);color-scheme:dark}.cms textarea{min-height:130px;resize:vertical}.cms-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}.cms-list{display:grid;gap:12px;margin:24px 0}.cms-list button{border:1px solid var(--color-border);border-radius:12px;padding:20px;background:var(--color-card);color:#fff;text-align:left;display:grid;gap:8px;overflow-wrap:anywhere}.cms-list strong{font:600 18px/26px var(--font-ui)}.cms-list span{font:400 13px/20px var(--font-ui);color:var(--color-muted)}.cms-checkbox{flex-direction:row!important;align-items:center}.cms-checkbox input{width:22px;min-height:22px}.cms-images{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;margin:20px 0}.cms-image{padding:16px;border:1px solid var(--color-border);border-radius:12px;min-width:0}.cms-image img{width:100%;height:180px;object-fit:contain;margin:12px 0}.cms-section-title{font:600 22px/30px var(--font-ui);margin-top:24px}.cms-preview{padding:24px;border:1px solid var(--color-border);border-radius:12px}.cms-preview p{white-space:pre-wrap;overflow-wrap:anywhere;margin:12px 0}.cms-preview h2{font:600 28px/36px var(--font-ui)}.cms-preview h3{font:600 18px/26px var(--font-ui);margin-top:20px}.cms .admin-control{min-height:44px}.cms [hidden], [data-cms-view][hidden]{display:none!important}@media(max-width:699px){.cms-fields{grid-template-columns:minmax(0,1fr)}.cms-heading{align-items:flex-start}.cms-images{grid-template-columns:minmax(0,1fr)}}
</style>
