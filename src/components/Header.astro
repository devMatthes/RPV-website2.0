---
import Brand from './Brand.astro';
import Button from './Button.astro';
const home = import.meta.env.BASE_URL;
const links = [{ label: 'O nas', href: `${home}o-nas/` }, { label: 'Usługi', href: `${home}#uslugi` }, { label: 'Realizacje', href: `${home}realizacje/` }, { label: 'Kontakt', href: `${home}kontakt/` }];
const menuLinks = [{ label: 'Strona główna', href: home }, ...links];
---
<header class="header">
  <a class="home" href={import.meta.env.BASE_URL} aria-label="RPV — strona główna"><Brand /></a>
  <nav class="desktop-nav" aria-label="Główna nawigacja">
    {links.map(link => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="header-actions">
    <Button href={`${import.meta.env.BASE_URL}serwis/`} variant="outline" class="service-action">Zgłoś serwis</Button>
    <button class="menu-button button button--ghost" aria-haspopup="dialog" data-menu-open>Menu</button>
  </div>
</header>
<dialog class="mobile-menu" aria-labelledby="menu-title">
  <div class="menu-heading"><a href={import.meta.env.BASE_URL} aria-label="RPV — strona główna"><Brand /></a><button class="button button--ghost" data-menu-close autofocus>Zamknij</button></div>
  <h2 id="menu-title" class="sr-only">Menu strony</h2>
  <nav aria-label="Nawigacja mobilna">{menuLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav>
  <div class="menu-actions"><Button href={`${import.meta.env.BASE_URL}kontakt/`}>Darmowa wycena</Button><Button href={`${import.meta.env.BASE_URL}serwis/`} variant="outline">Zgłoś serwis</Button></div>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('.mobile-menu');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  trigger?.addEventListener('click', () => { menu?.showModal(); document.body.style.overflow = 'hidden'; });
  const closeMenu = () => menu?.close();
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  menu?.addEventListener('close', () => { document.body.style.overflow = ''; trigger?.focus(); });
  matchMedia('(min-width: 1100px)').addEventListener('change', e => { if (e.matches) closeMenu(); });
</script>
<style>
  .header { height: 76px; padding-inline: var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: 24px; position: relative; }
  .home { display: inline-flex; }
  .desktop-nav { display: none; }
  .header-actions { display: flex; align-items: center; gap: 24px; }
  .header-actions :global(.service-action) { display: none; min-height: 46px; width: 172px; }
  .menu-button { padding-inline: 20px; background: transparent; }
  .mobile-menu { position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 24px; border: 0; background: #000; color: var(--color-text); }
  .mobile-menu::backdrop { background: #000; }
  .menu-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .mobile-menu nav { margin-top: 48px; display: flex; flex-direction: column; gap: 8px; }
  .mobile-menu nav a { font: 400 32px/1.3 var(--font-heading); padding-block: 12px; }
  .menu-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 700px) { .header { height: 86px; } .header-actions :global(.service-action) { display: flex; } }
  @media (min-width: 1100px) { .header { height: 81px; } .home, .header-actions { flex: 1; } .header-actions { justify-content: end; } .menu-button { display: none; } .desktop-nav { display: flex; gap: 8px; } .desktop-nav a { display: grid; place-items: center; min-height: 44px; padding-inline: 20px; font: 600 14px/21px var(--font-ui); border-radius: 8px; } .desktop-nav a:hover { background: #ffffff0d; } }
</style>
