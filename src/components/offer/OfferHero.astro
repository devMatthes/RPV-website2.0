---
import Button from '../Button.astro';
import OfferImage from './OfferImage.astro';
import type { OfferPageData } from '../../data/offers';
interface Props { page: OfferPageData; }
const { page } = Astro.props;
const { hero } = page;
const home = import.meta.env.BASE_URL;
---
<section class:list={['offer-hero', 'container', { 'pv': page.kind === 'pv' }]} aria-labelledby="page-title">
  <nav class="breadcrumbs" aria-label="Okruszki"><a href={home}>Strona główna</a><span aria-hidden="true"> / </span>{page.kind !== 'audience' && <><a href={`${home}#uslugi`}>Usługi</a><span aria-hidden="true"> / </span></>}<span aria-current="page">{page.name}</span></nav>
  <div class="hero-grid">
    <div class="copy"><p class="eyebrow">{hero.eyebrow}</p><h1 id="page-title">{hero.title}</h1><p class="description">{hero.description}</p><div class="actions"><Button href={`${import.meta.env.BASE_URL}kontakt/`}>{hero.primaryLabel}</Button><Button href={page.kind === 'pv' ? '#proces' : '#oferta'} variant="ghost">{hero.secondaryLabel}</Button></div>{hero.audiences && <p class="audiences">{hero.audiences}</p>}</div>
    {hero.image && <figure><OfferImage image={hero.image} alt={hero.image === 'house' ? 'Instalacja fotowoltaiczna na dachu domu' : 'Monter pracujący przy instalacji fotowoltaicznej'} priority class="hero-photo" /><figcaption>{hero.caption}</figcaption></figure>}
    {hero.focus && <aside class="focus" aria-label="Najważniejsze w tej usłudze"><p class="number">{hero.focus.number}</p><h2>{hero.focus.title}</h2><p class="focus-description">{hero.focus.description}</p><p class="meta">{hero.focus.meta}</p></aside>}
  </div>
</section>
<style>
  .offer-hero { padding-block: 32px 48px; display: flex; flex-direction: column; gap: 32px; }
  .breadcrumbs { font: 400 14px/21px var(--font-body); color: var(--color-muted); }
  .breadcrumbs a:hover { color: var(--color-text); text-decoration: underline; }
  .hero-grid { display: grid; gap: 32px; align-items: center; width: 100%; }
  .copy { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .eyebrow { color: var(--color-accent); font: 600 14px/21px var(--font-ui); }
  h1 { font: 500 42px/48px var(--font-heading); letter-spacing: -.7px; white-space: pre-line; overflow-wrap: break-word; }
  .description { font: 400 16px/24px var(--font-body); color: var(--color-muted); }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .actions :global(.button) { min-height: 48px; }
  .actions :global(.button--primary) { min-width: 174px; }
  .actions :global(.button--ghost) { padding-inline: 16px; }
  .audiences { font: 400 14px/21px var(--font-body); color: var(--color-muted); }
  figure { min-width: 0; width: 100%; display: flex; flex-direction: column; gap: 12px; }
  figure :global(.hero-photo) { height: 240px; }
  figcaption { font: 400 12px/18px var(--font-body); color: var(--color-muted); }
  .focus { width: 100%; padding: 24px; border-radius: var(--radius); background: var(--color-card); display: flex; flex-direction: column; gap: 16px; }
  .number { font: 500 42px/48px var(--font-heading); color: var(--color-accent); }
  .focus h2 { font: 400 24px/36px var(--font-heading); white-space: pre-line; letter-spacing: -.7px; }
  .focus-description { padding-top: 16px; border-top: 1px solid var(--color-border); color: var(--color-muted); font: 400 16px/24px var(--font-body); }
  .meta { font: 400 12px/18px var(--font-body); color: var(--color-muted); }
  .pv { gap: 40px; }
  .pv figure :global(.hero-photo) { height: 260px; }
  .pv figcaption { font-size: 14px; line-height: 21px; }
  @media (max-width: 359px) { h1 { font-size: 36px; line-height: 42px; } .actions :global(.button--primary) { min-width: 160px; } }
  @media (min-width: 700px) { .offer-hero { padding-block: 48px 64px; } h1 { font-size: 56px; line-height: 64px; } .description { font-size: 18px; line-height: 27px; } figure :global(.hero-photo), .pv figure :global(.hero-photo) { height: 420px; } .focus { padding: 40px; } .focus h2 { font-size: 36px; line-height: 41px; } .number { font-size: 72px; line-height: 83px; } .actions { gap: 16px; } .actions :global(.button) { min-height: 52px; } .actions :global(.button--primary) { min-width: 200px; } }
  @media (min-width: 1100px) { .offer-hero { padding-block: 64px 80px; gap: 40px; } .hero-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 80px; } .pv .hero-grid { align-items: start; } h1 { font-size: 72px; line-height: 83px; } figure :global(.hero-photo) { height: 460px; } .pv figure :global(.hero-photo) { height: 484px; } }
</style>
