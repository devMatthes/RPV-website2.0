---
import Button from '../Button.astro';
import TextBlock from './TextBlock.astro';
import Faq from './Faq.astro';
import OfferImage from './OfferImage.astro';
import type { OfferPageData } from '../../data/offers';
interface Props { page: OfferPageData; }
const { page } = Astro.props;
const home = import.meta.env.BASE_URL;
---
{page.sections.map(section => <section class:list={['offer-section', 'container', `section--${section.kind}`, {'pv':page.kind==='pv'}]} id={section.id} aria-labelledby={`${section.id}-title`}>
  {section.kind === 'cta' ? <div class="quote-panel"><div class="quote-copy"><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.description}</p></div><Button href="#kontakt" variant="secondary">{section.primaryLabel}</Button></div> : <>
    <div class="section-heading">{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}<h2 id={`${section.id}-title`}>{section.title}</h2>{section.description && <p class="section-description">{section.description}</p>}{section.kind === 'faq' && page.kind === 'pv' && <Button href="#kontakt" variant="ghost">Skontaktuj się →</Button>}</div>
    {['blocks','process','equipment','links'].includes(section.kind) && <div class:list={['block-grid', { 'four-columns': section.blocks.length === 4 && section.kind==='process' }]}>
      {section.kind === 'equipment' && <OfferImage image="technician" alt="Montaż paneli i podłączenie instalacji fotowoltaicznej" class="equipment-photo" />}
      {section.kind === 'equipment' ? <div class="equipment-blocks">{section.blocks.map(block => <TextBlock block={block} />)}</div> : section.blocks.map(block => section.kind === 'links' ? <article class="linked-block"><TextBlock block={block} /><a href={`${home}uslugi/${block.slug}/`} aria-label={`Zobacz usługę: ${block.title}`}>Zobacz usługę →</a></article> : <TextBlock block={block} />)}
    </div>}
    {section.kind === 'examples' && <div class="examples">{section.examples?.map(example => <figure><OfferImage image={example.image} alt={example.title === 'Na dachu domu' ? 'Panele fotowoltaiczne na dachu domu' : 'Montaż paneli fotowoltaicznych'} class="example-photo" /><figcaption><h3>{example.title}</h3><p>{example.description}</p></figcaption></figure>)}</div>}
    {section.kind === 'evidence' && <a class="text-link" href={`${home}#realizacje`}>Zobacz realizacje →</a>}
    {section.kind === 'faq' && <div class="questions"><Faq items={section.faq ?? []} />{section.sources && <div class="official-sources"><p>{section.sourceNote}</p>{section.sources.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>)}</div>}</div>}
  </>}
</section>)}
<style>
  .offer-section { padding-block: 48px; display: flex; flex-direction: column; gap: 32px; }
  .section-heading { display: flex; flex-direction: column; align-items: start; gap: 16px; min-width: 0; }
  h2 { font: 400 32px/37px var(--font-heading); letter-spacing: -.7px; white-space: pre-line; overflow-wrap: break-word; }
  .eyebrow { color: var(--color-accent); font: 600 14px/21px var(--font-ui); }
  .section-description, figcaption p { font: 400 16px/24px var(--font-body); color: var(--color-muted); }
  .block-grid, .examples { display: grid; grid-template-columns: minmax(0,1fr); gap: 32px; width: 100%; }
  .linked-block { min-width: 0; display: flex; flex-direction: column; align-items: start; justify-content: space-between; gap: 20px; padding: 24px; border: 1px solid var(--color-border); border-radius: var(--radius); }
  .linked-block a, .text-link { font: 600 14px/21px var(--font-ui); padding-block: 8px; min-height: 48px; display: inline-flex; align-items: center; }
  .linked-block a:hover, .text-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .equipment-blocks { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .block-grid :global(.equipment-photo) { height: 260px; }
  figure { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  figure :global(.example-photo) { height: 230px; }
  figcaption { display: flex; flex-direction: column; gap: 16px; }
  figcaption h3 { font: 600 22px/32px var(--font-ui); }
  .questions { min-width: 0; }
  .official-sources { margin-top: 24px; display: flex; flex-direction: column; gap: 16px; font: 400 14px/21px var(--font-body); }
  .official-sources p { color: var(--color-muted); }
  .official-sources a { color: var(--color-accent); text-underline-offset: 4px; }
  .official-sources a:hover { text-decoration: underline; }
  .quote-panel { width: 100%; display: flex; flex-direction: column; align-items: start; gap: 24px; padding: 24px; border-radius: var(--radius); background: var(--color-accent); color: var(--color-on-accent); }
  .quote-copy { min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .quote-copy p { font: 400 16px/24px var(--font-body); }
  .quote-panel :global(.button) { min-width: 220px; min-height: 52px; }
  .pv { gap: 40px; }
  .pv .quote-panel { gap: 32px; }
  @media (max-width: 359px) { .quote-panel :global(.button) { min-width: 0; width: 100%; } }
  @media (min-width: 700px) { .offer-section { padding-block: 64px; } h2 { font-size: 40px; line-height: 46px; } .section-description { font-size: 18px; line-height: 27px; } .block-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } .section--equipment .block-grid, .four-columns { grid-template-columns: minmax(0,1fr); } .section--links .block-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 32px 24px; } .linked-block { min-height: 251px; } .examples { grid-template-columns: repeat(2,minmax(0,1fr)); } figure :global(.example-photo) { height: 240px; } .block-grid :global(.equipment-photo) { height: 400px; } .quote-panel { padding: 48px; } .section--faq { display: grid; grid-template-columns: minmax(0,1fr); } }
  @media (min-width: 1100px) { .offer-section { padding-block: 80px; } h2 { font-size: 48px; line-height: 55px; } .section--links .block-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 32px 24px; } .four-columns { grid-template-columns: repeat(4,minmax(0,1fr)); gap: 24px; } .section--equipment .block-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 80px; } .block-grid :global(.equipment-photo) { height: 520px; } figure :global(.example-photo) { height: 340px; } .section--faq { grid-template-columns: 400px minmax(0,1fr); gap: 80px; } .pv .quote-panel { flex-direction: row; align-items: center; } .pv .quote-copy { flex: 1; } .pv .block-grid:not(.four-columns) { gap: 40px; } .pv.section--equipment .block-grid { gap: 80px; } .pv.section--blocks .block-grid :global(.text-block), .pv.section--process .block-grid :global(.text-block) { min-height: 240px; } }
</style>
