---
import Brand from './Brand.astro';
import { audiences } from '../data/home';
import {publicContact,publicPhoneHref} from '../data/published';
interface Props { extended?: boolean; projectFooter?: boolean; }
const { extended = false, projectFooter = false } = Astro.props;
const home = import.meta.env.BASE_URL;
---
<footer class:list={['footer', { 'footer--projects': projectFooter }]} id="kontakt">
  <div class="footer-columns container">
    <div class="footer-brand"><Brand variant="footer" projectFooter={projectFooter} /><p>{publicContact.footerDescription}</p></div>
    <nav aria-label="Oferta"><h2>Oferta</h2>{audiences.map(a => <a href={`${home}${a.slug}/`}>{a.title}</a>)}</nav>
    <nav aria-label="Linki w stopce"><h2>Linki</h2><a href={`${home}realizacje/`}>Realizacje</a><a href={`${home}o-nas/`}>O nas</a><a href={`${import.meta.env.BASE_URL}kontakt/`}>Kontakt</a><a href={`${home}poradnik/`}>Poradnik</a>{extended && <a href={`${home}faq/`}>FAQ</a>}<button type="button" data-cookie-open disabled>Ustawienia cookies</button></nav>
    <div class="contact"><h2>{publicContact.footerContactHeading}</h2><a href={publicPhoneHref}>{publicContact.phone}</a><a href={`mailto:${publicContact.email}`}>{publicContact.email}</a></div>
  </div>
  <div class="footer-bottom container"><p>@ Copyright by Consmatt. All rights reserved.</p><nav aria-label="Informacje prawne"><span>Polityka prywatności</span><span>Polityka cookies</span><span>Regulamin</span></nav></div>
</footer>
<style>
  .footer { padding-block: 64px 32px; }
  .footer-columns { display: grid; gap: 40px; }
  .footer-brand { display: flex; flex-direction: column; gap: 24px; }
  .footer-brand p { color: var(--color-muted); font: 400 16px/24px var(--font-heading); max-width: 360px; }
  nav, .contact { display: flex; flex-direction: column; align-items: start; gap: 8px; }
  h2 { font: 400 20px/30px var(--font-heading); }
  a, nav > span, nav > button { display: flex; align-items: center; min-height: 28px; font: 600 14px/21px var(--font-ui); }
  nav > button { padding: 0; border: 0; background: none; text-align: left; }
  nav > button:disabled { opacity: .6; cursor: not-allowed; }
  a:hover, nav > button:not(:disabled):hover { text-decoration: underline; text-underline-offset: 5px; }
  .footer-bottom { border-top: 1px solid var(--color-border); padding-top: 48px; margin-top: 48px; display: flex; flex-direction: column; gap: 32px; }
  .footer-bottom p { color: var(--color-muted); font: 400 14px/21px var(--font-heading); }
  @media (min-width: 700px) { .footer-columns { grid-template-columns: 1fr 1fr; gap: 48px 64px; } .footer-bottom nav { flex-direction: row; gap: 32px; flex-wrap: wrap; } }
  @media (min-width: 700px) and (max-width: 1099px) { .footer--projects { padding-block: 120px 40px; } .footer--projects .footer-columns { grid-template-columns: minmax(0,1fr); gap: 64px; } .footer--projects .footer-brand p { max-width: none; } }
  @media (min-width: 1100px) { .footer { padding-block: 120px 40px; } .footer-columns { max-width: 1242px; grid-template-columns: 360fr 230fr 230fr 230fr; gap: 64px; } .footer-bottom { flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; } }
  @media (min-width: 700px) and (max-width: 1099px) {
    .footer-columns, .footer--projects .footer-columns { grid-template-columns: 1.5fr .8fr .8fr 1.15fr; gap: 24px; }
    .footer-brand p { font-size: 13px; line-height: 20px; }
    .footer-columns a, .footer-columns button { font-size: 12px; }
  }
  @media (max-width: 699px) {
    .footer-columns { grid-template-columns: .9fr 1fr 1.2fr; gap: 24px 12px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-columns h2 { font-size: 15px; line-height: 22px; }
    .footer-columns a, .footer-columns button { font-size: 11px; line-height: 17px; overflow-wrap: anywhere; }
  }
  @media (max-width: 1099px) {
    .footer-bottom { flex-direction: row; align-items: center; justify-content: space-between; gap: 16px; }
    .footer-bottom p { font-size: 11px; line-height: 17px; max-width: 42%; }
    .footer-bottom nav { flex-direction: row; flex-wrap: nowrap; gap: 16px; }
    .footer-bottom nav > span { font-size: 11px; line-height: 17px; }
  }
  @media (max-width: 699px) {
    .footer-bottom { gap: 12px; }
    .footer-bottom p, .footer-bottom nav > span { font-size: 9px; line-height: 14px; }
    .footer-bottom nav { gap: 10px; }
  }
</style>
