---
interface Props { label: string; guide?: boolean; }
const {label,guide=false}=Astro.props;
const home=import.meta.env.BASE_URL;
---
<nav aria-label="Ścieżka nawigacji" class="breadcrumbs"><a href={home}>Strona główna</a> / {guide && <><a href={`${home}poradnik/`}>Poradnik</a> / </>}<span aria-current="page">{label}</span></nav>
<style>.breadcrumbs{font:400 14px/21px var(--font-body);color:var(--color-muted)}</style>
