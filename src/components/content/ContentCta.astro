---
import Button from '../Button.astro';
interface Props { editorial?: boolean; title?: string; }
const {editorial=false,title='Porozmawiajmy o Twojej instalacji.'}=Astro.props;
---
<section class="content-section container" aria-labelledby="content-cta-title"><div class="panel"><h2 class="content-heading" id="content-cta-title">{title}</h2><p>{editorial ? 'Porozmawiajmy o Twoim budynku i planach. Dobór rozwiązania zaczynamy od potrzeb, nie od gotowego zestawu.' : 'Opowiedz nam o swoim budynku i potrzebach. Dobierzemy zakres prac i przygotujemy wycenę.'}</p><Button href={`${import.meta.env.BASE_URL}kontakt/`} variant="secondary">{editorial?'Porozmawiajmy':'Darmowa wycena'}</Button></div></section>
<style>.panel{width:100%;display:flex;flex-direction:column;align-items:start;gap:24px;padding:24px;border-radius:24px;background:var(--color-accent);color:var(--color-on-accent)}p{font:400 16px/24px var(--font-body)}.panel :global(.button){min-width:190px;min-height:48px;padding-block:12px}@media(min-width:700px){.panel{padding:48px}}</style>
