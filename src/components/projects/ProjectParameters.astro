---
interface Props { items: { label: string; value: string }[]; }
const { items } = Astro.props;
---
<dl class="parameters">{items.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>
<style>
  .parameters { margin: 0; width: 100%; display: flex; flex-direction: column; gap: 24px; }
  .parameters > div { min-width: 0; display: flex; flex-direction: column; gap: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--color-border); }
  dt { color: var(--color-muted); font: 400 14px/21px var(--font-body); }
  dd { margin: 0; font: 600 16px/23px var(--font-ui); }
</style>
