---
import type {PublishedImage} from '../../lib/publication-types';
interface Props {image:PublishedImage;class?:string;priority?:boolean;sizes?:string;}
const {image,class:className='',priority=false,sizes='(max-width: 699px) calc(100vw - 48px), 1280px'}=Astro.props;
const base=import.meta.env.BASE_URL;
const srcset=image.srcset.split(', ').map(part=>base+part).join(', ');
---
<picture class={className}><img src={base+image.src} srcset={srcset} sizes={sizes} width={image.width} height={image.height} alt={image.alt} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} decoding="async" /></picture>
<style>picture{display:block;overflow:hidden;border-radius:16px}img{display:block;width:100%;height:100%;object-fit:cover}</style>
