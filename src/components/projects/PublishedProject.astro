---
import type {Project} from '../../data/projects';
import {projectCategories} from '../../data/projects';
import PublishedImage from './PublishedImage.astro';
import ProjectParameters from './ProjectParameters.astro';
interface Props {project:Project;}
const {project}=Astro.props;const data=project.cms!;const home=import.meta.env.BASE_URL;const category=projectCategories.find(c=>c.id===project.category)!.label;
const story=[['01 / ZAŁOŻENIA','Założenia projektu',data.assumptions],['02 / ZAKRES','Zakres prac',data.scope],['03 / REZULTAT','Rezultaty',data.result]].filter(([, ,text])=>text);
---
<section class="project-section project-intro container" data-published-project><a class="back-link" href={`${home}realizacje/`}>← Wszystkie realizacje</a><nav class="project-breadcrumbs" aria-label="Okruszki"><a href={`${home}realizacje/`}>Realizacje</a> / <span>{category}</span></nav><h1>{data.title}</h1><p class="project-description">{data.introduction}</p></section>
<section class="project-section container published-gallery" aria-label="Zdjęcia realizacji" data-cms-gallery>{project.gallery!.map((image,index)=><figure><a href={home+image.src} data-cms-image aria-haspopup="dialog" aria-label={`Powiększ: ${image.alt}`}><PublishedImage image={image} priority={index===0} /></a><figcaption>{String(index+1).padStart(2,'0')} / {image.alt}</figcaption></figure>)}<dialog data-cms-lightbox aria-labelledby="cms-gallery-title"><div class="gallery-dialog-heading"><h2 id="cms-gallery-title">Zdjęcie realizacji</h2><button type="button" class="button button--outline" data-cms-gallery-close autofocus>Zamknij</button></div><img data-cms-full alt="" /></dialog></section>
{project.parameters.length>0&&<section class="project-section container"><ProjectParameters items={project.parameters} /></section>}
<section class="project-section container"><h2 class="project-heading">Potrzeba. Rozwiązanie. Efekt.</h2><div class="project-columns">{story.map(([index,title,text])=><article><p class="eyebrow">{index}</p><h3>{title}</h3><p class="project-description lines">{text}</p></article>)}</div></section>
{data.specification&&<section class="project-section container"><h2 class="project-heading">Specyfikacja instalacji.</h2><p class="project-description lines">{data.specification}</p></section>}
<script>
 const gallery=document.querySelector<HTMLElement>('[data-cms-gallery]'),dialog=gallery?.querySelector<HTMLDialogElement>('dialog');
 if(gallery&&dialog){let trigger:HTMLAnchorElement|undefined,overflow='';const image=dialog.querySelector<HTMLImageElement>('[data-cms-full]')!;gallery.querySelectorAll<HTMLAnchorElement>('[data-cms-image]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();trigger=link;const thumbnail=link.querySelector('img')!;image.src=link.href;image.alt=thumbnail.alt;image.width=Number(thumbnail.getAttribute('width'));image.height=Number(thumbnail.getAttribute('height'));overflow=document.body.style.overflow;dialog.showModal();document.body.style.overflow='hidden';}));gallery.querySelector('[data-cms-gallery-close]')!.addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>{document.body.style.overflow=overflow;image.removeAttribute('src');trigger?.focus();});dialog.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close();}});}
</script>
<style>.published-gallery dialog{width:min(1328px,calc(100vw - 32px));max-height:90dvh;border:1px solid var(--color-border);border-radius:16px;padding:24px;background:var(--color-page);color:var(--color-text)}.published-gallery dialog::backdrop{background:#000d}.published-gallery dialog img{display:block;max-width:100%;height:auto;max-height:75dvh;object-fit:contain;margin-top:20px}.gallery-dialog-heading{display:flex;justify-content:space-between;align-items:center;gap:16px}h1{overflow-wrap:anywhere}.published-gallery{padding-top:0!important}.published-gallery figure{margin:0;display:grid;gap:12px}.published-gallery figure+figure{margin-top:20px}.published-gallery figcaption{font:400 14px/22px var(--font-ui);color:var(--color-muted)}.published-gallery :global(picture){max-height:720px}.back-link{display:inline-flex;min-height:48px;align-items:center;font:600 14px/21px var(--font-ui)}h3{font:600 24px/32px var(--font-ui);margin:16px 0}.eyebrow{font:600 14px/21px var(--font-ui);color:var(--color-accent)}.lines{white-space:pre-line;overflow-wrap:anywhere}</style>
