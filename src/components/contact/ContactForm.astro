---
import FormField from './FormField.astro';
import { contactTopics } from '../../lib/contact-types';
const home=import.meta.env.BASE_URL;
const api=import.meta.env.PUBLIC_SERVICE_API_URL??'';
---
<div class="form-panel" id="formularz">
  <nav class="topic-switch" aria-label="Rodzaj kontaktu"><a href={`${home}kontakt/`} aria-current="page">Kontakt</a><a href={`${home}serwis/`}>Zgłoś serwis</a></nav>
  <div class="form-introduction"><h2>Napisz do nas</h2><p>Zapytaj o wycenę, rozwiązania lub współpracę.</p></div>
  <form data-contact-form data-api={api} novalidate method="post" autocomplete="on">
    <div class="fields">
      <div class="field-row"><FormField name="name" label="Imię i nazwisko *" placeholder="Jak się nazywasz?" required autocomplete="name" maxlength={120} /><FormField name="phone" label="Telefon (opcjonalnie)" placeholder="Numer telefonu" type="tel" inputmode="tel" autocomplete="tel" maxlength={30} /></div>
      <FormField name="email" label="Adres e-mail *" placeholder="twoj@email.pl" type="email" inputmode="email" required autocomplete="email" maxlength={254} />
      <FormField name="topic" label="Temat wiadomości *" placeholder="Wybierz temat" kind="select" required options={[...contactTopics]} />
      <FormField name="message" label="Wiadomość *" placeholder="Opisz, czego potrzebujesz. Możesz podać miejscowość i rodzaj planowanej instalacji." kind="textarea" required maxlength={5000} />
    </div>
    <label class="privacy"><input name="privacy" type="checkbox" required aria-describedby="field-privacy-error" /><span>Rozumiem, że RPV wykorzysta moje dane do obsługi wiadomości. Nie podawaj informacji, które nie dotyczą Twojego zapytania. *</span></label>
    <p id="field-privacy-error" class="error" hidden></p>
    <div class="honeypot" aria-hidden="true"><label for="contact-website">Strona internetowa</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" maxlength="200" /></div>
    <p class="api-notice" hidden></p>
    <div class="form-feedback" role="status" aria-live="polite" tabindex="-1" hidden></div>
    <button class="button submit" type="submit" disabled>Wyślij wiadomość</button>
    <noscript><p>Włącz JavaScript lub napisz na <a href="mailto:kontakt@rpv.pl">kontakt@rpv.pl</a> albo zadzwoń: <a href="tel:+48515114676">515 114 676</a>.</p></noscript>
    <p class="required-note">* Pola wymagane</p>
  </form>
</div>
<script>import '../../scripts/contact-form';</script>
<style>
.form-panel{display:flex;flex-direction:column;gap:24px;min-width:0;width:100%;padding:24px;border:1px solid var(--color-border);border-radius:16px;background:var(--color-card)}
.topic-switch{display:flex;gap:8px;padding:4px;border-radius:999px;background:var(--color-page);width:100%}.topic-switch a{display:flex;align-items:center;justify-content:center;min-height:44px;flex:1;min-width:0;font:600 14px/21px var(--font-ui);border-radius:999px;white-space:nowrap}.topic-switch [aria-current="page"]{background:var(--color-accent)}
.form-introduction{display:flex;flex-direction:column;gap:8px}h2{font:600 24px/34px var(--font-ui)}.form-introduction p{font:400 14px/20px var(--font-ui);color:var(--color-muted)}
form{width:100%;display:flex;flex-direction:column;align-items:start;gap:24px}.fields{width:100%;display:flex;flex-direction:column;gap:20px}.field-row{display:grid;gap:20px;width:100%;grid-template-columns:minmax(0,1fr)}
.privacy,.api-notice,.required-note{font:400 12px/17px var(--font-ui);color:var(--color-muted)}.form-feedback{padding:16px;border:1px solid var(--color-border);border-radius:8px;font:400 14px/21px var(--font-body)}.submit{min-width:190px;min-height:52px}.submit:disabled{opacity:.6;cursor:not-allowed}
.attachments{display:flex;flex-direction:column;gap:8px;font:400 12px/18px var(--font-ui)}.attachments label{font:600 14px/21px var(--font-ui)}.attachments .attachment-input{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}.attachments .attachment-button{display:inline-flex;align-items:center;justify-content:center;align-self:start;min-height:48px;padding:12px 16px;border:1px solid var(--color-border);border-radius:8px;background:transparent;color:var(--color-text);font:600 14px/21px var(--font-ui);cursor:pointer}.attachment-input:focus-visible + .attachment-button{outline:2px solid #8dccff;outline-offset:5px}.attachments p{color:var(--color-muted)}.attachments .file-error{color:#ff9d9d}.file-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;width:100%}.file-list :global(li){display:flex;gap:16px;align-items:center;justify-content:space-between}.file-list :global(span){overflow-wrap:anywhere;min-width:0}.file-list :global(button){background:none;border:1px solid var(--color-border);border-radius:8px;min-height:44px;padding:8px}
@media(min-width:700px){.form-panel{padding:32px}.field-row{grid-template-columns:repeat(2,minmax(0,1fr))}h2{font-size:28px;line-height:39px}}
.privacy{display:flex;gap:12px;align-items:start}.privacy input{width:22px;height:22px;flex-shrink:0;accent-color:var(--color-accent)}.honeypot{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.error{color:#ff9d9d;font:400 12px/18px var(--font-ui)}[hidden]{display:none!important}</style>
