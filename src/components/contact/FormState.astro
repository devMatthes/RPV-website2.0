---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Button from '../Button.astro';
import TextBlock from '../offer/TextBlock.astro';
import {messageNextSteps,serviceNextSteps} from '../../data/form-states';
interface Props { state: 'message' | 'service' | 'error'; }
const {state}=Astro.props;
const home=import.meta.env.BASE_URL;
const error=state==='error';
const service=state==='service';
const title=error?'Wiadomość nie została wysłana.':service?'Dziękujemy. Zgłoszenie przyjęte.':'Dziękujemy. Wiadomość wysłana.';
---
<ContentLayout title={title} description={error?'Spróbuj ponownie lub skontaktuj się z RPV telefonicznie lub mailowo.':'Podgląd ekranu potwierdzenia formularza RPV.'}>
<section class="content-section container"><nav class="breadcrumbs" aria-label="Ścieżka nawigacji"><a href={home}>Strona główna</a> / <a href={`${home}kontakt/`}>Kontakt</a> / <span aria-current="page">{error?'Błąd wysyłania':service?'Serwis':'Potwierdzenie'}</span></nav>{!error&&<p class="preview">Podgląd ekranu potwierdzenia. Żadna wiadomość ani zgłoszenie nie zostały wysłane.</p>}<p class="eyebrow">{error?'NIE UDAŁO SIĘ WYSŁAĆ':'POTWIERDZENIE'}</p><h1>{error?'Wiadomość': 'Dziękujemy.'}<br /> {error?'nie została wysłana.':service?'Zgłoszenie przyjęte.':'Wiadomość wysłana.'}</h1><p class="content-description">{error?'Spróbuj ponownie lub skontaktuj się z nami telefonicznie lub mailowo.':service?'Zgłoszenie zostało przekazane do RPV. Skontaktujemy się z Tobą, aby ustalić dalsze kroki. Przyjęcie zgłoszenia nie jest potwierdzeniem terminu wizyty.':'Twoja wiadomość dotarła do RPV. Skontaktujemy się z Tobą po zapoznaniu się ze szczegółami.'}</p><div class="state-actions"><Button href={error?`${home}kontakt/#formularz`:home}>{error?'Spróbuj ponownie':'Strona główna'}</Button><a class="text-link" href={`${home}${service?'serwis':'kontakt'}/`}>Wróć do {service?'serwisu':'kontaktu'} →</a></div>{error&&<><div class="divider"></div><a class="channel" href="tel:+48515114676">+48 515 114 676</a><a class="channel" href="mailto:kontakt@rpv.pl">kontakt@rpv.pl</a></>}</section>
{!error&&<section class="content-section container"><h2 class="content-heading">Co dalej?</h2><div class="content-columns">{(service?serviceNextSteps:messageNextSteps).map(block=><TextBlock block={block} />)}</div></section>}
</ContentLayout>
<style>.breadcrumbs{font:400 14px/21px var(--font-body);color:var(--color-muted)}.preview{font:400 14px/21px var(--font-body);color:var(--color-muted)}.state-actions{display:flex;flex-direction:column;align-items:start;gap:16px}.state-actions :global(.button){width:200px;min-height:48px;padding-block:12px}.channel{font:400 24px/36px var(--font-body)}@media(min-width:700px){.state-actions{flex-direction:row;gap:16px;align-items:center}}</style>
