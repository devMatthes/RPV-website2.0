---
import { Picture } from 'astro:assets';
import Brand from '../Brand.astro';
import Button from '../Button.astro';
import {publishedTexts} from '../../data/published';
const copy=publishedTexts('home');
import landscape from '../../assets/figma/desktop-img03LandscapeBanner.png';
import technician from '../../assets/figma/desktop-imgPhotoSolarPanelInstallationTechnician.png';
interface Props { variant?: 'landscape' | 'technician'; }
const { variant = 'landscape' } = Astro.props;
const home = import.meta.env.BASE_URL;
---
<section class:list={['banner', `banner--${variant}`]} aria-label="Instalacje dla Twoich potrzeb">
  <Picture src={variant === 'landscape' ? landscape : technician} alt="" formats={['avif','webp']} fallbackFormat="webp" widths={[390, 780, 1200, 1920]} sizes="(max-width: 1920px) 100vw, 1920px" quality={80} pictureAttributes={{ class: 'banner-image' }} />
  <Brand variant="banner" />
  <div class="banner-content"><h2>{copy.bannerHeading}</h2><p>{copy.bannerDescription}</p><Button href={`${home}realizacje/`} variant="secondary">Nasze realizacje</Button></div>
</section>
<style>
  .banner { position: relative; isolation: isolate; min-height: 690px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .banner :global(.banner-image) { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .banner :global(.banner-image img) { width: 100%; height: 100%; object-fit: cover; }
  .banner::after { content: ''; position: absolute; inset: 0; background: #0000001f; z-index: -1; }
  .banner--technician::after { background: #0000002b; }
  .banner-content { display: flex; flex-direction: column; gap: 24px; max-width: 1000px; align-items: start; font-family: var(--font-heading); }
  h2 { font-size: 36px; line-height: 41px; font-weight: 400; letter-spacing: -.7px; }
  p { font-size: 16px; line-height: 24px; }
  @media (max-width: 699px) { .banner-content { width: 100%; } .banner-content :global(.button) { width: 100%; min-height: 52px; } }
  @media (min-width: 700px) { .banner { min-height: 800px; padding: 48px; } .banner-content { gap: 32px; } h2 { font-size: 48px; line-height: 55px; } p { font-size: 24px; line-height: 36px; } }
  @media (min-width: 1100px) { .banner { padding: 80px; } h2 { font-size: 64px; line-height: 74px; } }
</style>
