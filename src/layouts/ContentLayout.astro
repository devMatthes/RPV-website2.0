---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; about?: boolean; editorial?: boolean; }
const {title,description,about=false,editorial=false}=Astro.props;
---
<BaseLayout title={`${title} — RPV`} description={description}><div class:list={['content-page',{about,editorial}]}><Header /><main id="main"><slot /></main><Footer extended projectFooter /></div></BaseLayout>
<style>
.content-page{position:relative;isolation:isolate;max-width:1920px;margin-inline:auto}
.content-page::before{content:'';position:absolute;inset:0 0 auto;height:680px;background:linear-gradient(to bottom,#1b85e81a,transparent);z-index:-1;pointer-events:none}
.about::before{height:840px}
.content-page :global(.content-section){display:flex;flex-direction:column;align-items:start;gap:32px;padding-block:48px}
.content-page :global(h1){font:500 42px/48px var(--font-heading);letter-spacing:-.7px;white-space:pre-line;overflow-wrap:break-word}
.editorial :global(h1){font:700 40px/46px var(--font-body)}
.content-page :global(.content-heading){font:400 32px/37px var(--font-heading);letter-spacing:-.7px;white-space:pre-line}
.content-page :global(.content-description){font:400 16px/24px var(--font-body);color:var(--color-muted)}
.editorial :global(.intro-description){font:400 20px/30px var(--font-body);color:var(--color-muted)}
.content-page :global(.eyebrow){font:600 14px/21px var(--font-body);color:var(--color-accent)}
.content-page :global(.content-note){font:400 12px/18px var(--font-body);color:var(--color-muted)}
.content-page :global(.content-columns){display:grid;grid-template-columns:minmax(0,1fr);gap:32px;width:100%}
.content-page :global(.text-link){display:inline-flex;align-items:center;min-height:48px;font:600 14px/21px var(--font-ui)}
.content-page :global(a:hover){text-decoration:underline;text-underline-offset:5px}
.content-page :global(.divider){width:100%;border-top:1px solid var(--color-border)}
@media(min-width:700px){.content-page :global(.content-section){padding-block:64px}.content-page :global(h1){font-size:56px;line-height:64px}.editorial :global(h1){font-size:48px;line-height:55px}.content-page :global(.content-heading){font-size:40px;line-height:46px}.content-page :global(.content-description){font-size:18px;line-height:27px}.content-page :global(.content-columns){grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(min-width:1100px){.about::before{height:680px}.content-page :global(.content-section){padding-block:80px}.content-page :global(h1){font-size:72px;line-height:83px}.editorial :global(h1){font-size:64px;line-height:74px}.content-page :global(.content-heading){font-size:48px;line-height:55px}.editorial :global(.content-heading){font-size:40px;line-height:46px}}
</style>
