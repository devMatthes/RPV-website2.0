---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/content/Breadcrumbs.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ServiceForm from '../components/service/ServiceForm.astro';
interface Props { service?: boolean; }
const {service=false}=Astro.props;
const home=import.meta.env.BASE_URL;
---
<BaseLayout title={`${service?'Serwis':'Kontakt'} — RPV`} description="Skontaktuj się z RPV w sprawie instalacji, wyceny lub serwisu."><div class="contact-page"><Header /><main id="main" class="container contact-main"><div class="introduction"><Breadcrumbs label="Kontakt" /><h1>Porozmawiajmy o Twojej instalacji.</h1><p>Planujesz nową instalację lub potrzebujesz wsparcia? Wybierz temat i napisz do nas.</p></div><div class="contact-content"><aside class="direct-contact"><div class="channels"><h2>Wolisz porozmawiać?</h2><a class="phone" href="tel:+48515114676">+48 515 114 676</a><a class="email" href="mailto:kontakt@rpv.pl">kontakt@rpv.pl</a></div><p>{service?'Opisz problem i dodaj zdjęcia instalacji. Pomogą nam sprawniej ocenić zgłoszenie.':'Opowiedz nam o swoich potrzebach. Pomożemy dobrać rozwiązanie do Twojego domu, firmy lub inwestycji.'}</p><div class="shortcut"><p>{service?'Masz pytanie o nową instalację?':'Masz już instalację i potrzebujesz pomocy?'}</p><a href={`${home}${service?'kontakt':'serwis'}/`}>{service?'Przejdź do kontaktu →':'Przejdź do serwisu →'}</a></div></aside>{service ? <ServiceForm /> : <ContactForm />}</div></main><Footer extended projectFooter /></div></BaseLayout>
<style>
.contact-page{max-width:1920px;margin-inline:auto}.contact-main{padding-block:32px 64px;display:flex;flex-direction:column;gap:32px}.introduction{display:flex;flex-direction:column;gap:16px}h1{font:500 40px/56px var(--font-heading);overflow-wrap:break-word}.introduction>p{font:400 16px/23px var(--font-body);color:var(--color-muted)}.contact-content{display:grid;grid-template-columns:minmax(0,1fr);gap:32px}.direct-contact{display:flex;flex-direction:column;gap:32px;min-width:0}.channels{display:flex;flex-direction:column;gap:12px}h2{font:600 16px/22px var(--font-ui)}.phone{font:500 24px/34px var(--font-ui)}.email{font:400 20px/28px var(--font-ui)}.direct-contact p{font:400 14px/20px var(--font-ui);color:var(--color-muted)}.shortcut{display:none}.shortcut a{display:inline-flex;align-items:center;min-height:48px;font:600 14px/21px var(--font-ui)}a:hover{text-decoration:underline;text-underline-offset:5px}
@media(min-width:700px){.contact-main{padding-block:64px 96px;gap:48px}h1{font-size:48px;line-height:67px}.introduction>p{font-size:18px;line-height:25px}.phone{font-size:32px;line-height:45px}.email{font-size:24px;line-height:34px}}
@media(min-width:1100px){h1{font-size:64px;line-height:90px}.contact-content{grid-template-columns:360px minmax(0,1fr);gap:80px}.shortcut{display:flex;flex-direction:column;gap:12px}}
</style>
