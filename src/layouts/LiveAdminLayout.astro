---
import '../styles/global.css';import '../styles/admin.css';import symbol from '../assets/admin/symbol.svg?url';
interface Props { cms?: boolean }
const {cms=false}=Astro.props;
const home=import.meta.env.BASE_URL;const api=import.meta.env.PUBLIC_SERVICE_API_URL ?? '';
const panel=import.meta.env.PANEL_BUILD==='true'?'/panel/':`${home}panel/live/`;
const cmsPath=import.meta.env.PANEL_BUILD==='true'?'/panel/realizacje/':`${home}panel/live/realizacje/`;
const publicHome=import.meta.env.PANEL_BUILD==='true'?'https://rpv.pl/':home;
const nav=[['serwis','Serwis'],['kontakt','Kontakt']] as const;
---
<!doctype html><html lang="pl"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="same-origin" /><link rel="icon" href={symbol} type="image/svg+xml" /><title>Panel serwisowy — RPV</title></head>
<body class="admin" data-live-admin={!cms || undefined} data-cms-admin={cms || undefined} data-public-api={api}><a class="skip-link" href="#main">Przejdź do treści</a>
<header class="admin-mobile-header"><a class="admin-brand" href={panel} aria-label="RPV — panel"><img src={symbol} width="42" height="36" alt="" /><span>RPV</span></a><button class="admin-control" data-menu-open aria-haspopup="dialog" aria-controls="panel-menu">Menu</button></header>
<div class="admin-shell"><aside class="admin-sidebar"><a class="admin-brand" href={panel} aria-label="RPV — panel"><img src={symbol} width="42" height="36" alt="" /><span>RPV</span></a><p class="admin-caption">PANEL ADMINA</p><nav aria-label="Moduły panelu">{nav.map(([key,label])=><a class="admin-nav-item" data-module={key} href={`${panel}?module=${key}`}>{label}<span data-count={key}>—</span></a>)}<a class:list={["admin-nav-item",{"is-current":cms}]} href={cmsPath}>Realizacje</a><span class="admin-nav-item admin-nav-disabled" aria-disabled="true"><span>Przetargi</span><span class="admin-caption">Wkrótce</span></span></nav><div class="admin-account"><a href={publicHome}>Otwórz stronę RPV ↗</a><strong data-admin-name>Administrator</strong><button class="admin-control" data-logout hidden>Wyloguj</button></div></aside><div class="admin-main"><div class="admin-context"><span>Panel admina / <span data-context-module>{cms?'Realizacje':'Serwis'}</span></span><span>Prywatne zgłoszenia</span></div><main id="main" class="admin-content"><slot /></main></div></div>
<dialog id="panel-menu" class="admin-menu" aria-labelledby="menu-title"><div class="admin-menu-heading"><h2 id="menu-title">Panel admina</h2><button class="admin-control" data-menu-close>Zamknij</button></div><nav aria-label="Moduły panelu mobilnego">{nav.map(([key,label])=><a class="admin-nav-item" data-module={key} href={`${panel}?module=${key}`}>{label}</a>)}<a class:list={["admin-nav-item",{"is-current":cms}]} href={cmsPath}>Realizacje</a><span class="admin-nav-item admin-nav-disabled" aria-disabled="true">Przetargi · Wkrótce</span></nav><button class="admin-control" data-logout hidden>Wyloguj</button></dialog>
<script>import '../scripts/admin-live';</script></body></html>
