NODE_ENV=development
HOST=127.0.0.1
PORT=8787
API_ORIGIN=http://127.0.0.1:8787
PUBLIC_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
ADMIN_USER=admin
# Generate with server/hash-password.ts; never use a plaintext password here.
ADMIN_PASSWORD_HASH=
DATA_DIR=.service-data
# Optional. Enable Places API (New), restrict to API and server IP.
GOOGLE_PLACES_API_KEY=
GOOGLE_DAILY_LIMIT=100
GOOGLE_MONTHLY_LIMIT=1000
# Serve the private panel from the same origin as the API (cookies).
STATIC_DIR=dist
STATIC_BASE=/

# Only trust the exact reverse-proxy IP; never use true or 0.0.0.0/0.
TRUST_PROXY=
# Production only, used by Docker Compose / Caddy; hostname without https://
API_HOST=
